---
Checks: >
  -*,
  bugprone-*,
  performance-*,
  portability-*,
  readability-*,
  modernize-*,
  cppcoreguidelines-*,
  clang-analyzer-*,
  misc-*,
  -bugprone-easily-swappable-parameters,
  -readability-identifier-length,
  -readability-braces-around-statements,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -modernize-use-trailing-return-type,
  -readability-uppercase-literal-suffix,
  -readability-magic-numbers,
  -readability-redundant-member-init,
  -portability-avoid-pragma-once,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -misc-non-private-member-variables-in-classes

# Off: nothing consumes clang-tidy's exit code (see the TODO at the bottom).
# To gate a single run, pass --warnings-as-errors='*' on the command line.
WarningsAsErrors: ''

HeaderFilterRegex: '.*'

# Third-party code (FetchContent deps) is analyzed transitively but must not be
# reported — its naming/style is out of our control.
ExcludeHeaderFilterRegex: '_deps/'

FormatStyle: file

CheckOptions:
  - key: modernize-use-nullptr.NullMacros
    value: 'NULL'

  - key: modernize-loop-convert.MinConfidence
    value: reasonable

  - key: modernize-use-auto.MinTypeNameLength
    value: '8'
    # Only flag `auto` for genuinely long type names; short ones like `float`/`int`
    # stay explicit

  - key: readability-identifier-naming.VariableCase
    value: lower_case

  - key: readability-identifier-naming.MemberCase
    value: lower_case
    # Members get a trailing underscore when private, matching PrivateMemberSuffix below.

  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
    # Public data members (e.g. component structs) are plain snake_case, no suffix.

  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case

  - key: readability-identifier-naming.ParameterCase
    value: lower_case

  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case

  - key: readability-identifier-naming.GlobalVariableCase
    value: lower_case

  - key: readability-identifier-naming.StaticVariableCase
    value: lower_case

  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
    # Standard-mandated member typedef names (transparent comparators, iterator
    # traits, allocator/container nested types) must keep their exact spellings.
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^(value_type|key_type|mapped_type|size_type|difference_type|reference|const_reference|pointer|const_pointer|iterator|const_iterator|is_transparent|rebind)$'

  - key: readability-identifier-naming.TypedefCase
    value: CamelCase

  - key: readability-identifier-naming.TemplateParameterCase
    value: CamelCase

  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE

  - key: readability-identifier-naming.FunctionCase
    value: lower_case

  - key: readability-identifier-naming.ClassCase
    value: CamelCase

  - key: readability-identifier-naming.EnumCase
    value: CamelCase

  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase

  - key: readability-identifier-naming.ConstexprVariableCase
    value: lower_case

  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k_

  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _

  - key: cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor
    value: 'true'

  # Function-shape thresholds. Calibrated so a nested x/y loop with one braced
  # if (complexity 6, ~13 statements, nesting 4) still passes, allowing roughly
  # two to three such passes; clang-tidy counts the function body as level 1.
  - key: readability-function-cognitive-complexity.Threshold
    value: '15'
    # LLVM default is 25.

  - key: readability-function-cognitive-complexity.IgnoreMacros
    value: 'true'
    # doctest CHECK/REQUIRE expand to branches; without this every test body
    # needs a NOLINT.

  - key: readability-function-size.StatementThreshold
    value: '40'
    # LLVM default is 800, i.e. effectively off.

  - key: readability-function-size.NestingThreshold
    value: '4'
    # The function body is level 1, so a fourth nested braced block inside it
    # (e.g. for/for/if/while) is flagged.

# TODO(cleanup): LLVM Clang 23 surfaces ~7700 findings across
# cppcoreguidelines-*, bugprone-easily-swappable-parameters, and
# performance-*. Warnings-as-errors temporarily disabled above; re-enable
# once the findings are addressed in a separate plan. The dominant
# bounds-check check was disabled in-place (see above).
