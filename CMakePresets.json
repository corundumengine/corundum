{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 0
  },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/llvm-clang.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
        "CMAKE_LINK_WARNING_AS_ERROR": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug (GLFW + sokol)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release (optimised, no debug symbols)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "debug-sanitized",
      "displayName": "Debug (ASan + UBSan)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-sanitized",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "docs",
      "displayName": "Debug + Doxygen docs",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-docs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CORUNDUM_BUILD_DOCS": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "build",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug-sanitized",
      "configurePreset": "debug-sanitized",
      "verbose": true
    },
    {
      "name": "format",
      "configurePreset": "debug",
      "targets": ["format_code"]
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": ["build_docs"]
    }
  ],

  "testPresets": [
    {
      "name": "test",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    },
    {
      "name": "debug-sanitized",
      "configurePreset": "debug-sanitized",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "jobs": 0
      }
    }
  ]
}
